<Project Sdk="Microsoft.NET.Sdk">

  <!-- A handful of features written to be drawn: a message outbox, whose Send queues its sending for a
       worker. It's never run, only compiled, so it has facilities' interfaces and no implementations. Its
       output folder holds Featurewise.Core.dll too, which the extractor needs beside it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Featurewise.Core" Version="0.1.0-preview.12" />
  </ItemGroup>

</Project>
